	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="busqueda" class="java.lang.String"/>
	<parameter name="inicio" class="java.lang.String"/>
	<parameter name="fin" class="java.lang.String"/>
	<parameter name="idUsuario" class="java.lang.Long"/>
	<parameter name="LOGO_LOGO" class="java.io.InputStream"/>
	<parameter name="IMAGEN_DEFAULT" class="java.io.InputStream"/>
	<queryString>
		<![CDATA[SELECT  
    user.nombre AS Nombre,
    user.apellidop AS Apellido_Paterno,
    user.apellidom AS Apellido_Materno,
    user.genero AS Genero,
    user.edad AS Edad,
    user.telefono AS Telefono,
    municipio.nombre AS Municipio,
    user.colonia AS Colonia,
    user.correo AS Correo,
    user.foto AS Foto
FROM user
JOIN municipio ON user.id_municipio = municipio.id
WHERE 1=1
AND user.rol = 'BENEFICIARIO'
AND ($P{idUsuario} IS NULL OR user.id = $P{idUsuario})
AND (
    $P{busqueda} IS NULL  
    OR CONCAT(user.nombre, ' ', user.apellidop, ' ', user.apellidom)
       LIKE CONCAT('%', $P{busqueda}, '%')
)
AND ($P{inicio} IS NULL OR DATE(user.fecha_registro) >= $P{inicio})
AND ($P{fin} IS NULL OR DATE(user.fecha_registro) <= $P{fin})]]>
	</queryString>
