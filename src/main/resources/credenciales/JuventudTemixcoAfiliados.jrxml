	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="mysqlConnector"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="busqueda" class="java.lang.String"/>
	<parameter name="inicio" class="java.time.LocalDate"/>
	<parameter name="fin" class="java.time.LocalDate"/>
	<parameter name="idUsuario" class="java.lang.Long"/>
	<parameter name="LOGO_LOGO" class="byte[]"/>
	<parameter name="IMAGEN_DEFAULT" class="byte[]"/>
	<queryString>
		<![CDATA[ SELECT user.nombre AS Nombre,
    user.apellidop AS Apellido_Paterno,
    user.apellidom AS Apellido_Materno,
    user.genero AS Genero,
    user.edad AS Edad,
    user.telefono AS Telefono,
    user.foto AS Foto
FROM user
WHERE 1=1
AND user.rol = 'AFILIADO'
AND ($P{idUsuario} IS NULL OR user.id = $P{idUsuario})
AND (
    $P{busqueda} IS NULL  
    OR CONCAT(user.nombre, ' ', user.apellidop, ' ', user.apellidom)
       LIKE CONCAT('%', $P{busqueda}, '%')
)
AND ($P{inicio} IS NULL OR DATE(user.fecha_registro) >= $P{inicio})
AND ($P{fin} IS NULL OR DATE(user.fecha_registro) <= $P{fin})]]>
	</queryString>
